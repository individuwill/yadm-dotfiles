# ~/.myprofile

bindkey -e

# ---- Basics ----
export EDITOR="vim"
export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"

export DOTNET_NEW_PREFERRED_LANG="F#"
export DOTNET_ROOT="/usr/local/share/dotnet"
export PAGER="most"

# Aliases
alias sssh="ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
alias oe="op run --env-file=.env -- "
alias oel="op run --env-file=.env.local -- "
alias yt="youtube-dl --external-downloader aria2c --external-downloader-args '-c -j 3 -x 3 -s 3 -k 1M'"
alias ls="lsd"
# alias vim="nvim"
alias fixcam="sudo killall avconferenced"

# Tmux session helper
tt() {
  # use the argument if given, otherwise the current dir's name
  local name="${1:-$(basename "$PWD")}"
  # tmux treats . and : specially in session names — replace them
  name="${name//[.:]/_}"

  if [ -n "$TMUX" ]; then
    # already inside tmux: create detached if needed, then switch
    tmux has-session -t "=$name" 2>/dev/null || tmux new-session -d -s "$name" -c "$PWD"
    tmux switch-client -t "=$name"
  else
    tmux new-session -A -s "$name" -c "$PWD"
  fi
}

# Enable shell history for elixir iex
export ERL_AFLAGS="-kernel shell_history enabled"

# ---- Deterministic base PATH (zsh-native, deduped) ----

typeset -U path PATH
path=(
  "$HOME/.config/emacs/bin"
  "/Applications/WezTerm.app/Contents/MacOS"
  "$HOME/.cargo/bin"
  "$HOME/.cache/rebar3/bin"
  "/opt/homebrew/opt/coreutils/libexec/gnubin"
  "$HOME/.rd/bin"
  "$HOME/google-cloud-sdk/bin"
  "$HOME/.poetry/bin"
  "$HOME/.local/bin"
  "$HOME/bin"
  "$DOTNET_ROOT"
  "/usr/local/go/bin"
  "$HOME/go/bin"
  "/opt/homebrew/bin"
  "/opt/homebrew/sbin"
  "$HOME/.lmstudio/bin"
  "$HOME/.antigravity/antigravity/bin"
  "$HOME/Application Support/JetBrains/Toolbox/scripts"
  "/Applications/Postgres.app/Contents/Versions/latest/bin"
  "$HOME/.arctl/bin"
  $path
)
export PATH

# ---- Tool inits ----

# opam
[[ ! -r "$HOME/.opam/opam-init/init.zsh" ]] || source "$HOME/.opam/opam-init/init.zsh" > /dev/null 2> /dev/null

# direnv
eval "$(direnv hook zsh)"

# mise (version manager — may tweak PATH and set shims)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Completions that require zsh completion system (compinit) should be interactive-only
if [[ -o interactive ]]; then
  source <(kubectl completion zsh)

  # UV Python
  eval "$(uv generate-shell-completion zsh)"
  eval "$(uvx --generate-shell-completion zsh)"
fi

# Cargo (may tweak PATH)
. "$HOME/.cargo/env"

# luaver (may tweak PATH)
if command -v luaver >/dev/null 2>&1; then
  . "$(command -v luaver)"
fi

# orbstack (may tweak PATH)
source "$HOME/.orbstack/shell/init.zsh" 2>/dev/null || :

### Begin private shell env setup ###
PRIVATE_DIR="$HOME/.config/shell"
PRIVATE_ENV="$PRIVATE_DIR/private_env.sh"
GITIGNORE="$PRIVATE_DIR/.gitignore"

mkdir -p "$PRIVATE_DIR"

# Create/ensure .gitignore that keeps the directory but ignores other contents
if [[ ! -f "$GITIGNORE" ]]; then
  cat >"$GITIGNORE" <<'EOF'
# Keep this directory in git, but ignore its contents (secrets, local files)
*
!.gitignore
EOF
fi

# Create the env file if missing; lock down perms
if [[ ! -f "$PRIVATE_ENV" ]]; then
  touch "$PRIVATE_ENV"
  chmod 600 "$PRIVATE_ENV"
fi

# Resolve the op:// references with 1Password only when needed. Each terminal pane is a
# separate 1Password authorization, so running `op inject` in every shell means one prompt per
# tmux window. A shell started by tmux (or by another shell) inherits the already-resolved
# values, so skip the call when every variable exported by the file is set to a real value.
# Force a refresh (e.g. after rotating a secret) with: PRIVATE_ENV_REFRESH=1 exec $SHELL
_need_inj=${PRIVATE_ENV_REFRESH:-0}
if [[ -r "$PRIVATE_ENV" && "$_need_inj" != 1 ]]; then
  while IFS= read -r _line; do
    case "$_line" in
      export\ [A-Za-z_]*=*)
        _n=${_line#export }; _n=${_n%%=*}
        eval "_v=\${$_n-}"
        case "$_v" in ""|op://*) _need_inj=1 ;; esac
        ;;
    esac
  done < "$PRIVATE_ENV"
fi
if [[ "$_need_inj" == 1 && -r "$PRIVATE_ENV" ]] && command -v op >/dev/null 2>&1; then
  # op-cached-inject (~/.local/bin) serves the values from the login Keychain for 12 hours, so
  # only the first shell after expiry or a reboot prompts. Falls back to plain `op inject`.
  _ok=0
  if command -v op-cached-inject >/dev/null 2>&1; then
    if [[ "${PRIVATE_ENV_REFRESH:-0}" == 1 ]]; then
      _inj=$(op-cached-inject --refresh "$PRIVATE_ENV") && _ok=1
    else
      _inj=$(op-cached-inject "$PRIVATE_ENV") && _ok=1
    fi
  else
    _inj=$(op inject -i "$PRIVATE_ENV") && _ok=1
  fi
  if [[ "$_ok" == 1 ]]; then
    eval "$_inj"
  else
    printf 'warning: resolving 1Password references failed for %s\n' "$PRIVATE_ENV" >&2
  fi
  unset _inj _ok
fi
unset _need_inj _line _n _v

### End private shell env setup ###

# Local overrides (may tweak PATH, env, etc.)
[[ -r "$HOME/.myprofile.local" ]] && source "$HOME/.myprofile.local"

# ---- FINAL PATH CANONICALIZATION (force identical ordering) ----
typeset -U path PATH

# Remove pinned entries anywhere they already exist
path=(${path:#/opt/homebrew/bin})
path=(${path:#/opt/homebrew/sbin})
path=(${path:#$HOME/.luarocks/bin})


front=(
  "$HOME/.luarocks/bin"
  "/opt/homebrew/bin"
  "/opt/homebrew/sbin"
)

# Drop empty entries (if nvm isn't active)
front=(${front:#""})

path=($front $path)
export PATH

# ---- Optional: auto-start zellij only when not already inside it ----
if [[ "$TERM_PROGRAM" == "vscode" ]]; then
  :
elif [[ "$TERM_PROGRAM" == "zed" ]]; then
  :
elif [[ "$TERMINAL_EMULATOR" == "JetBrains-JediTerm" ]]; then
  :
else
  if [[ -z "$ZELLIJ" && -o interactive && -z "$NO_ZELLIJ" ]]; then
    # exec zellij -l welcome
    :
  fi
fi

# this is a global claude code timeout... it might slow down real failures
# but we're seeing some ttfb responses timing out now < 60 second default
export CLAUDE_CODE_CONNECT_TIMEOUT_MS=120000

export SPECIAL_CLAUDE_PROXY_PORT=8090
export SPECIAL_CLAUDE_PROXY_OPTIONS='--set ssl_verify_upstream_trusted_ca=$NETSKOPE_CA_BUNDLE --set tcp_timeout=1800 --set stream_large_bodies=1'

# OS-specific tail (mac vs linux paths, aliases, etc.)
[[ -r "$HOME/.myprofile.os" ]] && source "$HOME/.myprofile.os"

mitmrun() {
  HTTPS_PROXY=http://127.0.0.1:$SPECIAL_CLAUDE_PROXY_PORT \
  HTTP_PROXY=http://127.0.0.1:$SPECIAL_CLAUDE_PROXY_PORT \
  NO_ROXY=localhost,127.0.0.1,.rxrx.io,.misuse.us \
  "$@"
}
alias mitm-dev-web="mitmweb -p $SPECIAL_CLAUDE_PROXY_PORT $SPECIAL_CLAUDE_PROXY_OPTIONS --set store_streamed_bodies=true "
alias mitm-dev-dump="mitmdump -p $SPECIAL_CLAUDE_PROXY_PORT $SPECIAL_CLAUDE_PROXY_OPTIONS "
alias mitm-cc="mitm-dev-dump -s $HOME/.config/mitmproxy/claude.py --allow-hosts '^api\.anthropic\.com:443'"
alias mitm-cc-web="mitm-dev-web -s $HOME/.config/mitmproxy/claude.py --allow-hosts '^api\.anthropic\.com:443'"
alias ccpower="mitmrun claude"

export CLAUDE_CODE_SCROLL_SPEED=3
